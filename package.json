{
  "name": "crash-beats-tape-deck",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "qa:visual": "node scripts/visual-qa.mjs",
    "qa:email": "node scripts/email-qa.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply crash-beats-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply crash-beats-db --remote",
    "audio:import": "node scripts/import-audio.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.2",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.62.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0",
    "yauzl": "^3.4.0"
  }
}
